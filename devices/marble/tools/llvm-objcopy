#!/usr/bin/env python3
"""Small llvm-objcopy compatibility shim for Mu's single-section BootShim ELF."""
import struct
import sys
from pathlib import Path

if len(sys.argv) != 5 or sys.argv[1:3] != ["-O", "binary"]:
    raise SystemExit("Marble shim supports only: llvm-objcopy -O binary INPUT OUTPUT")

source, destination = map(Path, sys.argv[3:])
elf = source.read_bytes()
if elf[:6] != b"\x7fELF\x02\x01":
    raise SystemExit(f"not a little-endian ELF64 file: {source}")
shoff = struct.unpack_from("<Q", elf, 40)[0]
shentsize, shnum, shstrndx = struct.unpack_from("<HHH", elf, 58)
sections = [struct.unpack_from("<IIQQQQIIQQ", elf, shoff + i * shentsize) for i in range(shnum)]
strings = sections[shstrndx]
names = elf[strings[4]:strings[4] + strings[5]]
text_section = next(s for s in sections if names[s[0]:].split(b"\0", 1)[0] == b".text")
destination.write_bytes(elf[text_section[4]:text_section[4] + text_section[5]])
